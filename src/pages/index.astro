---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import { getCollection } from "astro:content";
import CardLink from '../components/Card-Link.astro';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
const allWork = await getCollection("professional");
const allPosts = await getCollection("personal")
---

<Layout>
	
	<div class="container">
		<img src="../../Self Portrait.png" width="250" style="float: left;"> 
		<div style="display: block; padding-left: 2em;">
			<h2>Hello, I'm Campbell Turner.</h2>
			<p>
				I am a junior programmer who has been making small games since I was 12. I graduated from 
				Embry Riddle Aeronautical University with a degree in Simulation Science Games and 
				Animation in 2024. This degree is a mix of computer science, art, game design, and 
				production that taught me a lot about programming patterns and programming best practices. 
			</p>
			<p>
				I love putting things together and taking them apart to figure out how they work as well
				as solving puzzles. Game programming not only satisfies those desires but lets me work in 
				an industry that I have been in awe of for over a decade. I also love that working in games
				requires me to always be learning and pushing myself to improve since there are always new
				engines to learn and new techniques to try.
			</p>
		</div>
		<br> <br>
	</div>
	<h1>Skills</h1>
	<div class="container" style="justify-content: center;">
		<div style="padding-right: 4em">
		<li>Unity</li>
		<li>Unreal</li>
		<li>Godot</li>
		<li>Playdate SDK</li>
		<li>Naninovel</li>
		</div>
		<div style="padding-right: 4em">
		<li>C#</li>
		<li>C++</li>
		<li>Blueprints</li>
		</div>
		<div style="padding-right:4em ">
		<li>Jira</li>
		<li>Trello</li>
		<li>Git and Github</li>
		<li>Visual Studio</li>
		<li>Visual Studio Code</li>
		</div>
	</div>
	<div style="display: block;">
	<h1>Projects</h1>
	<h2>Professional Work</h2>
	<ul role="list" class="link-card-grid">
				{allWork.sort((a,b) => 
				{
					return Date.parse(a.data.pubDate.toUTCString()) - Date.parse(b.data.pubDate.toUTCString())
				}
				).map((work) => <CardLink
				pubDate={work.data.pubDate}
				title={work.data.title}
				body={work.data.description}
				href={`../works/professional/${work.id}/`}
				image={work.data.image.url}
				link={work.data.link}
				/>)}
			</ul>
	<h2>Personal Projects</h2>
	<ul role="list" class="link-card-grid">
				{allPosts.sort((a,b) => 
				{
					return Date.parse(b.data.pubDate.toUTCString()) - Date.parse(a.data.pubDate.toUTCString())
				}
				).map((projects) => <Card
				pubDate={projects.data.pubDate}
				title={projects.data.title}
				body={projects.data.description}
				href={`../works/personal/${projects.id}/`}
				tags={projects.data.tags}
				/>)}
			</ul>
	</div>
	<h2>Want to Work Together?</h2>
	<div class="container" style="justify-content: center;">
		<p>
		Email me at campbellturner36[at]gmail.com
		</p>
		<p style="padding-left: 2em;"><a href="https://www.linkedin.com/in/campbell-j-turner/">Connect on LinkedIn</a></p>
	</div>
		
	
</Layout>
