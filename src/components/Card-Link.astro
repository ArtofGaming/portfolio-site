---
interface Props {
	title: string;
	body: string;
	href: string;
	image: string;
	pubDate: Date;
	link: string;
}

const { href, title, body, image, link} = Astro.props;
---
<div style="padding-left:0; padding-right:0; min-height:0; overflow:hidden; border-radius:5px;">
	<li class="link-card">
		<a href={link}>
			<div class="container">
				<img class="card-img" src={image} alt="project image">
				</img>
				<div style="display:grid; align-self: bottom;">
						<h2>
							{title}
						</h2>
					<p style="padding-right: 2em; padding-left: 2em; padding-bottom:1ch">
						{body}
					</p>
				</div>
			</div>
		</a>
	</li>
	
</div>
<style>
	.link-card {
		padding-top: 0em;
		background-color: rgb(40, 25, 7);
		background-image: none;
	
		min-height:0;
		height:17rem;
		width:100%;
		border-radius: 5px;
		background-position: 70%;
		opacity: .7;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		text-overflow:hidden;
		align-self: center;
	}
	.link-card > a {
		text-decoration: none;
		align-self: center;
		
		min-height:0;
		height:17rem;
		line-height: 1.4;
		padding-top: calc(1rem);
		width: 100%;
		color: white;
		opacity: 0.8;
		text-overflow:hidden;
	}
	h2 {
		text-align: center;
		font-size: 1.25rem;
		color: rgb(228, 157, 126);
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		margin-top:0em;
		padding-right: 2em;
		background-color: #36230c;
	}
	p {
		text-align: center;
		overflow:hidden;
		min-height:0;
		margin-top: 0;
		margin-bottom: 0;
		background-color: #36230c;
		padding-right: 2em;
	}
	.link-card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
	}
	.link-card:is(:hover, :focus-within) h2 {
		color: rgb(var(--accent-light));
	}
</style>
