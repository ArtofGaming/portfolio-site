---
interface Props {
	title: string;
	body: string;
	href: string;
	pubDate: Date;
	tags: string[];
}

const { href, title, body, pubDate, tags } = Astro.props;
---
<div style="padding-left:0; padding-right:0; min-height:0; overflow:hidden; border-radius:5px;">
	<li class="link-card">
		<a href={href}>
			<div class="container">
				</img>
				<div style="display:grid; align-self: bottom;">
					<h2 style="display:flex; text-align:justify;">{title} <p> </p>{pubDate.toDateString()}</h2>
					<p style="padding-left: 2em">Skills Used: {tags.map((tag) => (<span style="color:var(--link-color)">{tag} </span>))}</p>
					<p style="padding-right: 2em; padding-left: 2em; padding-bottom:1ch">
						{body}
					</p>
				</div>
			</div>
		</a>
	</li>
	
</div>
<style>
	.link-card {
		padding-top: 0em;
	
		min-height:0;
		height:17rem;
		width:100%;
		border-radius: 5px;
		opacity: 1;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		text-overflow:hidden;
	}
	.link-card > a {
		text-decoration: none;
		
		min-height:0;
		height:17rem;
		line-height: 1.4;
		padding-top: calc(1rem);
		width: 100%;
		color: white;
		opacity: 1;
		text-overflow:hidden;
	}
	h2 {
		text-align: center;
		font-size: 1.25rem;
		color: rgb(228, 157, 126);
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		margin-top:0em;
		padding-right: 2em;

	}
	p {
		overflow:hidden;
		min-height:0;
		margin-top: 0;
		margin-bottom: 0;
		padding-right: 2em;
	}
	.link-card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
	}
	.link-card:is(:hover, :focus-within) h2 {
		color: rgb(var(--link-color));
	}
</style>

